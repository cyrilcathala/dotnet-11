@page "/pilotage"
@inject MissionApi Api
@inject MissionState State

<StepHeader Step="Step" />

<div class="grid grid-side">
    <div class="stack">
        <Panel Title="Scénarios du runbook" Flush>
            @foreach (var s in Scenarios)
            {
                <button class="scenario @(_scenario == s ? "on" : "")" disabled="@_busy" @onclick="() => Prefill(s)">
                    <span class="scenario-id">@s.Id</span>
                    <span>
                        <span class="scenario-title">@s.Title</span>
                        <div class="scenario-hint">@s.Hint</div>
                    </span>
                    <span class="scenario-expect">@s.Expect</span>
                </button>
            }
        </Panel>

        <Panel Title="Console de commande">
            <div class="cmd-grid">
                @foreach (var c in CommandTypes)
                {
                    <button class="cmd @(_type == c.Type ? "on" : "")" @onclick="() => Select(c.Type)">
                        <span class="cmd-name">@c.Record</span>
                        <span class="cmd-type">@c.Type</span>
                    </button>
                }
            </div>
            @if (_type is "thrust" or "rotate")
            {
                <div class="field mt">
                    <label class="label" for="value">@(_type == "thrust" ? "DeltaV (km/s)" : "Degrees")</label>
                    <input id="value" class="input" type="number" step="0.5" @bind="_value" @bind:after="() => _scenario = null" />
                </div>
            }
            @if (_type == "self-destruct")
            {
                <div class="caveat mt">
                    <strong>Rendez-vous à l'étape suivante.</strong>
                </div>
            }
            <button class="btn btn-primary btn-block mt" disabled="@(_busy || _type == "self-destruct")" @onclick="SendAsync">
                Transmettre à @State.Probe
            </button>
        </Panel>
    </div>

    <div class="stack">
        <Panel Title="CommandResult" Framed>
            <Actions><span class="label">POST /commands</span></Actions>
            <ChildContent>
                <OutcomeBanner Exchange="_exchange" />
            </ChildContent>
        </Panel>

        <ExchangeView Exchange="_exchange" Busy="_busy" Title="Liaison MissionControl" />

        <Panel Title="OpenAPI · réponse de POST /commands" Flush>
            <Actions>
                <button class="btn btn-sm" @onclick="LoadOpenApiAsync">5.4 · Lire /openapi/v1.json</button>
            </Actions>
            <ChildContent>
                @if (_schema is null)
                {
                    <pre class="code-block empty">Document non chargé. L'union y est décrite en anyOf, un schéma par cas.</pre>
                }
                else
                {
                    <pre class="code-block" style="max-height: 320px">@((MarkupString)JsonHighlighter.ToHtml(_schema))</pre>
                }
            </ChildContent>
        </Panel>
    </div>
</div>

<div class="mt">
    <CodeCompare Title="Le contrat de commande · .NET 10 face à .NET 11" Pairs="Code" MaxHeight="560" />
</div>

<StepNav Step="Step" />

@code {
    private static readonly MissionStep Step = Mission.ByNumber(5);

    private record Scenario(string Id, string Title, string Hint, string Type, double? Value, string Expect);
    private record CommandType(string Type, string Record);

    private static readonly Scenario[] Scenarios =
    [
        new("5.1", "Poussée", "thrust · deltaV = 2.5", "thrust", 2.5, "Acknowledged"),
        new("5.2", "Poussée invalide", "thrust · deltaV = −1", "thrust", -1, "Rejected"),
        new("5.3", "Rotation", "rotate · degrees = 90", "rotate", 90, "Acknowledged"),
        new("—", "Photo", "capture-photo", "capture-photo", null, "Acknowledged"),
    ];

    private static readonly CommandType[] CommandTypes =
    [
        new("thrust", "Thrust"),
        new("rotate", "Rotate"),
        new("capture-photo", "CapturePhoto"),
        new("self-destruct", "SelfDestruct"),
    ];

    // Une vue par nouveauté : le type et son switch sont dans le même fichier, de chaque côté.
    private static readonly CodePair[] Code =
    [
        new("closed record", "compare/net10/Compare.Net10/MissionControl/ProbeCommand.cs", "src/MissionControl.Api/ProbeCommand.cs",
            ["abstract record", "_ => throw"], ["closed record", "SelfDestruct s =>"]),
        new("union", "compare/net10/Compare.Net10/MissionControl/CommandResult.cs", "src/MissionControl.Contracts/CommandResult.cs",
            ["abstract record", ": CommandResult", "_ => throw"], ["[JsonUnion", "union CommandResult", "ProbeLost =>"]),
    ];

    private Scenario? _scenario = Scenarios[0];
    private string _type = Scenarios[0].Type;
    private double? _value = Scenarios[0].Value;
    private bool _busy;
    private Exchange? _exchange;
    private string? _schema;

    // Un scénario ne part pas tout seul : il remplit la console, on transmet à la main.
    private void Prefill(Scenario s)
    {
        _scenario = s;
        _type = s.Type;
        _value = s.Value;
    }

    private void Select(string type)
    {
        _scenario = null;
        _type = type;
    }

    private async Task SendAsync()
    {
        _busy = true;
        _exchange = await Api.PostAsync(MissionApi.MissionControl, "/commands", Commands.Build(_type, State.Probe, _value));
        _busy = false;
    }

    private async Task LoadOpenApiAsync()
    {
        var ex = await Api.GetAsync(MissionApi.MissionControl, "/openapi/v1.json");
        if (ex.Json is not { } doc)
        {
            _schema = ex.Error ?? $"{ex.Status} {ex.Reason}";
            return;
        }
        var schema = doc["paths"]?["/commands"]?["post"]?["responses"]?["200"]?["content"]?["application/json"]?["schema"];
        // On résout la référence pour montrer l'anyOf sans fouiller le document.
        if (schema?["$ref"]?.GetValue<string>() is { } reference)
        {
            var name = reference.Split('/').Last();
            schema = new JsonObject { [name] = doc["components"]?["schemas"]?[name]?.DeepClone() };
        }
        _schema = schema?.ToJsonString(MissionApi.Pretty) ?? "Schéma introuvable.";
    }
}
