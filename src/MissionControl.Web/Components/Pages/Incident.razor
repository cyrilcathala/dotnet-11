@page "/incident"
@implements IDisposable
@inject MissionApi Api
@inject MissionState State
@inject IConfiguration Configuration

<StepHeader Step="Step" />

<div class="grid grid-wide">
    <TelemetryMonitor Probe="@State.Probe" />

    <div class="stack">
        <Panel Title="Autodestruction" Framed>
            <div class="note">Commande <code>SelfDestruct</code> sur <strong>@State.Probe</strong>. Le simulateur arrête le vol : le flux de télémétrie se tait.</div>
            @if (!_armed)
            {
                <button class="btn btn-danger btn-block mt" disabled="@_busy" @onclick="Arm">Armer · 6.1</button>
            }
            else
            {
                <div class="grid grid-2 mt">
                    <button class="btn" @onclick="() => _armed = false">Annuler</button>
                    <button class="btn btn-danger armed" disabled="@_busy" @onclick='() => SendAsync(new SelfDestruct(Guid.NewGuid(), State.Probe), "6.1")'>Confirmer</button>
                </div>
            }
        </Panel>

        <Panel Title="Après l'incident" Flush>
            <button class="scenario" disabled="@_busy" @onclick='() => SendAsync(new Thrust(Guid.NewGuid(), State.Probe, 1), "6.2")'>
                <span class="scenario-id">6.2</span>
                <span><span class="scenario-title">Relancer une poussée</span><div class="scenario-hint">Thrust · deltaV = 1 · @State.Probe</div></span>
                <span class="scenario-expect">ProbeLost</span>
            </button>
        </Panel>

        <Panel Title="CommandResult" Framed>
            <Actions><span class="label">POST /commands</span></Actions>
            <ChildContent>
                <OutcomeBanner Exchange="_exchange" />
            </ChildContent>
        </Panel>
    </div>
</div>

<div class="mt">
    <ExchangeView Exchange="_exchange" Busy="_busy" Title="Liaison MissionControl" />
</div>

<div class="grid grid-wide mt">
    <HistoryStream @ref="_history" />

    <Panel Title="Trace · OpenTelemetry natif" Framed>
        <div class="note">
            La commande traverse <code>console</code>, <code>missioncontrol</code> puis <code>probesimulator</code>.
            Aucun package <code>OpenTelemetry.Instrumentation.*</code> : ASP.NET Core et HttpClient émettent eux-mêmes leurs activités.
        </div>
        @if (_trace is { } trace)
        {
            <div class="note mt">Dernière commande : <strong>@trace.Label</strong> · <span class="mono">@trace.Id[..8]…</span></div>
            @if (TraceUrl(trace.Id) is { } url)
            {
                <a class="btn btn-primary btn-block mt" href="@url" target="_blank" rel="noopener">Ouvrir la trace dans le dashboard</a>
            }
            else
            {
                <div class="caveat mt"><strong>Dashboard inconnu.</strong> Lancer la console depuis l'AppHost, ou chercher la trace dans l'onglet Traces.</div>
            }
        }
        else
        {
            <div class="note mt">Envoyer une commande pour obtenir sa trace.</div>
        }
    </Panel>
</div>

<div class="mt">
    <CodeCompare Title="Le post-mortem · .NET 10 face à .NET 11" Pairs="Code" MaxHeight="420" />
</div>

<StepNav Step="Step" />

@code {
    private static readonly MissionStep Step = Mission.ByNumber(6);

    // Seulement les nouveautés .NET 11 du post-mortem : le journal JSONL et OpenTelemetry sans package d'instrumentation.
    private static readonly CodePair[] Code =
    [
        new("Journal JSONL", "compare/net10/Compare.Net10/MissionControl/CommandHistoryEndpoint.cs", "src/MissionControl.Api/Program.cs",
            ["WriteAsync", "'\\n'", "\\n"], ["SerializeAsyncEnumerable", "topLevelValues", "application/jsonl"]),
        new("OpenTelemetry · packages", "compare/net10/Compare.Net10/Compare.Net10.csproj", "src/MissionControl.ServiceDefaults/MissionControl.ServiceDefaults.csproj",
            ["OpenTelemetry.Instrumentation"], ["OpenTelemetry."]),
        new("OpenTelemetry · configuration", "compare/net10/Compare.Net10/ServiceDefaults/Extensions.cs", "src/MissionControl.ServiceDefaults/Extensions.cs",
            ["AddAspNetCoreInstrumentation", "AddHttpClientInstrumentation"], ["AddSource(\"Microsoft.AspNetCore\")", "AddMeter(", "Pas de package"]),
    ];

    private record Trace(string Label, string Id);

    private bool _armed, _busy;
    private Exchange? _exchange;
    private Trace? _trace;
    private HistoryStream? _history;
    private Timer? _disarm;

    private string? TraceUrl(string traceId) =>
        Configuration["Console:DashboardUrl"] is { Length: > 0 } dashboard
            ? $"{dashboard.TrimEnd('/')}/traces/detail/{traceId}"
            : null;

    private void Arm()
    {
        _armed = true;
        // Désarmement automatique, comme une sécurité de pupitre.
        _disarm?.Dispose();
        _disarm = new Timer(_ => InvokeAsync(() => { _armed = false; StateHasChanged(); }), null, 8000, Timeout.Infinite);
    }

    private async Task SendAsync(ProbeCommand command, string id)
    {
        _busy = true;
        _armed = false;
        _exchange = await Api.PostAsync(MissionApi.MissionControl, "/commands", command);
        _busy = false;
        if (_exchange.TraceId is { } traceId) _trace = new($"{id} · {command.GetType().Name}", traceId);
        if (_history is not null) await _history.LoadAsync();
    }

    public void Dispose() => _disarm?.Dispose();
}
