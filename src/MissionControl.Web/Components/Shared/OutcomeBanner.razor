@{ var outcome = CommandOutcome.From(Exchange?.Json); }
<div class="outcome">
    @foreach (var c in Cases)
    {
        <div class="outcome-case @(outcome?.Case == c ? "on " + outcome.Css : "")">
            <span class="label">case</span>
            <span class="outcome-name">@c</span>
        </div>
    }
</div>
<div class="note mt" style="min-height: 22px">
    @if (outcome is not null)
    {
        <span><strong>@outcome.Case</strong> · @outcome.Detail</span>
    }
    else if (Exchange?.Error is { } e)
    {
        <span style="color: var(--red)">@e</span>
    }
    else
    {
        <span>union CommandResult(Acknowledged, Rejected, TimedOut, ProbeLost)</span>
    }
</div>

@code {
    [Parameter] public Exchange? Exchange { get; set; }
    private static readonly string[] Cases = ["Acknowledged", "Rejected", "TimedOut", "ProbeLost"];
}
