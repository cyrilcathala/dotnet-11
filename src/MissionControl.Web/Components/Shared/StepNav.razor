<nav class="step-nav" aria-label="Étapes voisines">
    @if (Mission.Previous(Step) is { } prev)
    {
        <a href="@prev.Route" data-nav="prev">
            <span class="label"><span class="kbd">←</span> Étape @prev.Number.ToString("00")</span>
            <span class="t">@prev.Title</span>
        </a>
    }
    else
    {
        <a href="" data-nav="prev">
            <span class="label"><span class="kbd">←</span> Briefing</span>
            <span class="t">Vue d'ensemble</span>
        </a>
    }
    @if (Mission.Next(Step) is { } next)
    {
        <a href="@next.Route" data-nav="next">
            <span class="label">Étape @next.Number.ToString("00") <span class="kbd">→</span></span>
            <span class="t">@next.Title</span>
        </a>
    }
    else
    {
        <a href="" data-nav="next">
            <span class="label">Fin de mission <span class="kbd">→</span></span>
            <span class="t">Retour au briefing</span>
        </a>
    }
</nav>

@code {
    [Parameter, EditorRequired] public required MissionStep Step { get; set; }
}
