@implements IDisposable
@inject MissionState State

<div class="clock">
    <span class="label">UTC</span>
    <span class="clock-value">@_now.ToString("HH:mm:ss")</span>
</div>
<div class="clock">
    <span class="label">@(State.LiftoffAt is null ? "Console" : "Vol") T+</span>
    <span class="clock-value">@Elapsed</span>
</div>

@code {
    private DateTimeOffset _now = DateTimeOffset.UtcNow;
    private Timer? _timer;

    private string Elapsed
    {
        get
        {
            var t = _now - (State.LiftoffAt ?? State.ConsoleStartedAt);
            return $"{(int)t.TotalHours:00}:{t.Minutes:00}:{t.Seconds:00}";
        }
    }

    protected override void OnInitialized() =>
        _timer = new Timer(_ =>
        {
            _now = DateTimeOffset.UtcNow;
            InvokeAsync(StateHasChanged);
        }, null, 1000, 1000);

    public void Dispose() => _timer?.Dispose();
}
