<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- BL0012 signale comme inutiles les StateHasChanged dans les boucles avec await (animations,
         flux JSONL) : vérifié dans le navigateur, sans eux les étapes intermédiaires ne s'affichent pas. -->
    <NoWarn>$(NoWarn);BL0012</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../tools/Grid.cs" Link="Shared/Grid.cs" />
    <Compile Include="../../tools/Conjunction.cs" Link="Shared/Conjunction.cs" />
    <Compile Include="../../tools/RadarSweep.cs" Link="Shared/RadarSweep.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../MissionControl.Contracts/MissionControl.Contracts.csproj" />
    <ProjectReference Include="../MissionControl.ServiceDefaults/MissionControl.ServiceDefaults.csproj" />
  </ItemGroup>
</Project>
